# ClinicCare-Lite environment variables - Section E (Deployment)
#
# HOW TO USE THIS FILE:
# 1. Copy this file and rename the copy to exactly ".env"
#      (on Windows PowerShell:  copy .env.example .env)
# 2. Fill in real values below - NEVER commit the real ".env" file to
#    git. It should already be listed in .gitignore.
# 3. Restart the Flask app after any change to .env, since python-dotenv
#    only reads this file once, when the app first starts.

# A random, secret string used to sign session cookies. If this leaks,
# someone could forge a fake login session - keep it private.
# Generate one quickly with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Gmail address used to send submission/review/appointment notification
# emails (see utils/email_handler.py). Must be a real, working mailbox.
EMAIL_ADDRESS=your-clinic-notifications@gmail.com

# IMPORTANT: this is NOT your normal Gmail password. Gmail blocks
# regular password logins from apps like this one for security reasons.
# You need a 16-character "App Password" instead:
#   1. Turn on 2-Step Verification on the Google account
#      (myaccount.google.com/security)
#   2. Go to myaccount.google.com/apppasswords
#   3. Create a new app password named "ClinicCare-Lite"
#   4. Paste the 16-character code below (no spaces)
EMAIL_PASSWORD=your-16-character-app-password

# Set to "production" when deploying for real, "development" while
# building locally. Currently informational only - app.py doesn't
# branch on this yet, but it's here so environment-specific behaviour
# (e.g. disabling Flask's debug mode) has a place to check later.
FLASK_ENV=development
